# NODE_ENV=development

# HOST=localhost
# PORT=8000

# JWT_SECRET=<your-random-uuid>

# DATABASE_URL=<reachout-for-dev-version>
# AZURE_STORAGE_CONNECTION_STRING=<reachout-for-dev-version>

# IMAGEKIT_PUBLIC_KEY=<reachout-for-dev-version>
# IMAGEKIT_PRIVATE_KEY=<reachout-for-dev-version>
# IMAGEKIT_URL_ENDPOINT=<reachout-for-dev-version>

# SMTP_HOST=<reachout-for-dev-version>
# SMTP_USER=<reachout-for-dev-version>
# SMTP_PASS=<reachout-for-dev-version>
# SMTP_PORT=465                      # 465 = SSL (Gmail), 587 = STARTTLS (SES/SendGrid)
# SMTP_SECURE=true                   # true for 465, false for 587
# EMAILER=<reachout-for-dev-version>

# ALLOWED_ORIGINS="http://localhost:5173,https://localhost:8080"

# LOGO_URL=https://www.ypfafrica.org/assets/logo.png
# YEAR=2026
# VERSION=0.1.0

# # Job Queue Configuration
# JOB_CONCURRENCY=5
# JOB_RETENTION_DAYS=7
# JOB_RETRY_LIMIT=3
# JOB_RETRY_DELAY=60
# # Must be < 24 (pg-boss assertion: expireInHours cannot equal or exceed 24)
# JOB_ARCHIVE_HOURS=12


# # Production env
# # Core
# NODE_ENV=production
# HOST=0.0.0.0
# PORT=8080
# JWT_SECRET=                       # openssl rand -base64 48
#
# ─── JWT rotation strategy (audit I8) ──────────────────────────────────────
# Rotate JWT_SECRET on every prod deploy AND any time you suspect leakage.
# Mechanics:
#   1. CI generates a fresh secret per deploy: `openssl rand -base64 48`
#   2. New secret is written to the env (parameter store / secret manager).
#   3. App restart picks it up; all existing JWTs become invalid.
#   4. Users are forced to log in again — acceptable for an admin app.
# There is NO grace window today. If you want one, implement a token
# revocation list keyed by `jti` and check it in the auth middleware.
# ────────────────────────────────────────────────────────────────────────────
#
# ─── DATABASE_URL prod requirements (audit I7, enforced at startup) ────────
# Production startup REFUSES to boot if DATABASE_URL:
#   - points at localhost / 127.0.0.1 / ::1     → use a managed DB host
#   - is missing a password                     → use user:password@host
#   - has no sslmode=require (or stronger)      → append ?sslmode=require
# See configs/env.ts startup guards.
# ────────────────────────────────────────────────────────────────────────────
# ALLOWED_ORIGINS=https://ypfafrica.org,https://ums.ypfafrica.org
# DATABASE_URL=postgres://user:password@host:5432/ypf_prod?sslmode=require

# # Cache (strongly recommended)
# REDIS_URL=rediss://:password@host:6379

# # Public URLs (used in emails)
# DASHBOARD_URL=https://ums.ypfafrica.org
# WEBSITE_URL=https://ypfafrica.org
# LOGO_URL=https://ypfafrica.org/logo.png

# # Azure Blob (documents)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;...

# # ImageKit (media)
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/ypfafrica
# IMAGEKIT_PUBLIC_KEY=public_...
# IMAGEKIT_PRIVATE_KEY=private_...

# # Paystack (payments)
# PAYSTACK_SECRET=sk_live_...
# PAYSTACK_SUBACCOUNT_CODE=         # optional: ACCT_xxxxxxxxxxx

# # SMTP — AWS SES uses STARTTLS on port 587, so SMTP_SECURE=false
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAILER=no-reply@ypfafrica.com

# # Metadata
# YEAR=2026
# VERSION=                          # set from CI: $GIT_SHA

# # Job queue (defaults are fine — uncomment to override)
# # JOB_CONCURRENCY=5
# # JOB_RETENTION_DAYS=7
# # JOB_RETRY_LIMIT=3
# # JOB_RETRY_DELAY=60
# # JOB_ARCHIVE_HOURS=12

# Arkesel SMS (optional — when unset, every SMS call is a no-op and email continues working)
# ARKESEL_API_KEY=your-arkesel-api-key
# ARKESEL_SENDER_ID=YPF
# ARKESEL_BASE_URL=https://sms.arkesel.com/api/v2
# ARKESEL_SANDBOX=false   # set to true to simulate sends without actually delivering
