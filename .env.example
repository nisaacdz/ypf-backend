NODE_ENV=development

HOST=localhost
PORT=8000

JWT_SECRET=<your-random-uuid>

DATABASE_URL=<reachout-for-dev-version>
AZURE_STORAGE_CONNECTION_STRING=<reachout-for-dev-version>

IMAGEKIT_PUBLIC_KEY=<reachout-for-dev-version>
IMAGEKIT_PRIVATE_KEY=<reachout-for-dev-version>
IMAGEKIT_URL_ENDPOINT=<reachout-for-dev-version>

SMTP_HOST=<reachout-for-dev-version>
SMTP_USER=<reachout-for-dev-version>
SMTP_PASS=<reachout-for-dev-version>
EMAILER=<reachout-for-dev-version>

ALLOWED_ORIGINS="http://localhost:5173,https://localhost:8080"

LOGO_URL=https://www.ypfafrica.org/assets/logo.png
YEAR=2026
VERSION=0.1.0

# Job Queue Configuration
JOB_CONCURRENCY=5
JOB_RETENTION_DAYS=7
JOB_RETRY_LIMIT=3
JOB_RETRY_DELAY=60
# Must be < 24 (pg-boss assertion: expireInHours cannot equal or exceed 24)
JOB_ARCHIVE_HOURS=12
